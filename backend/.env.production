# ===================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===================================
# Cấu hình này dành cho production server
# ⚠️ QUAN TRỌNG: Thay đổi tất cả các giá trị mặc định!
# 🔒 Cấp độ bảo mật: HIGHEST

# App Config
APP_NAME=XDynamic API (PRODUCTION)
APP_VERSION=1.0.0
DEBUG=false
APP_URL=https://app.xdynamic.cloud/fe

# Database
# SQLite cho đơn giản, hoặc PostgreSQL cho production scale lớn
DATABASE_URL=sqlite:///data/app.db
# DATABASE_URL=postgresql://user:password@db.xdynamic.cloud:5432/xdynamic

# JWT Security
# ⚠️ QUAN TRỌNG: Tạo secret key mạnh, ví dụ: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY_IN_PRODUCTION_NOW
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth (Update với production credentials)
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_REDIRECT_URI=https://app.xdynamic.cloud/api/auth/google/callback

# MoMo Payment (PRODUCTION MODE)
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://app.xdynamic.cloud/api/payment/success
MOMO_IPN_URL=https://app.xdynamic.cloud/api/payment/momo/ipn

# ML Model
MODEL_PATH=mobilenetv2_dangerous_objects.pth
MODEL_IMG_SIZE=224

# Subscription Plans (VND) - Có thể khác test
PLAN_FREE_MONTHLY_QUOTA=1000
PLAN_PLUS_MONTHLY_QUOTA=5000
PLAN_PRO_MONTHLY_QUOTA=10000
PLAN_PLUS_PRICE=50000
PLAN_PRO_PRICE=100000

# CORS Security (Tighten trong production)
# Thêm vào main.py nếu cần
ALLOWED_ORIGINS=https://app.xdynamic.cloud,https://admin.xdynamic.cloud

