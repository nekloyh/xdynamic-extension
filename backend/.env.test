# ===================================
# TEST ENVIRONMENT CONFIGURATION
# ===================================
# Cấu hình này dành cho server test/staging
# Sử dụng để test deployment trước khi đưa lên production

# App Config
APP_NAME=XDynamic API (TEST)
APP_VERSION=1.0.0
DEBUG=true
APP_URL=https://test.xdynamic.cloud/fe

# Database
DATABASE_URL=sqlite:///data/app.db

# JWT Security
JWT_SECRET_KEY=test-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth (Test credentials)
GOOGLE_CLIENT_ID=your-test-google-client-id
GOOGLE_CLIENT_SECRET=your-test-google-client-secret
GOOGLE_REDIRECT_URI=https://test.xdynamic.cloud/api/auth/google/callback

# MoMo Payment (TEST MODE)
MOMO_PARTNER_CODE=MOMORLHW20251010_TEST
MOMO_ACCESS_KEY=b5RXYV16DfeKgelm
MOMO_SECRET_KEY=your-test-secret-here
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://test.xdynamic.cloud/api/payment/success
MOMO_IPN_URL=https://test.xdynamic.cloud/api/payment/momo/ipn

# ML Model
MODEL_PATH=mobilenetv2_dangerous_objects.pth
MODEL_IMG_SIZE=224

# Subscription Plans (VND)
